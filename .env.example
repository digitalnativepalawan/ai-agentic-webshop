# Server-only application secrets. Keep values blank in source control.
ADMIN_PASSKEY=
# At least 32 random characters in production. Falls back to ADMIN_PASSKEY only for local development.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MINUTES=120
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Self-hosted Postiz site URL, for example http://localhost:4007.
# The application resolves the standard /api/public/v1 backend path.
POSTIZ_API_URL=
POSTIZ_API_KEY=
